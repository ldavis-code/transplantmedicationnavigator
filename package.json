{
  "name": "transplant-medication-navigator",
  "version": "1.0.0",
  "description": "From Prescription to Possession - Free guide for transplant patients",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:readability && npm run check:i18n && npm run check:conditions && node scripts/generate-home-stats.js && node scripts/generate-program-eligibility.js && node scripts/generate-sitemap.js && vite build && node scripts/inject-route-preloads.js --entry && node scripts/stamp-freshness.js && node scripts/prerender-seo.js && node scripts/inject-route-preloads.js --pages",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.js",
    "sync:medications": "node scripts/sync-medications-json.js",
    "conditions:apply": "node scripts/apply-medication-conditions.js",
    "check:conditions": "node scripts/apply-medication-conditions.js --check",
    "sync:endpoints": "node sync_endpoints_to_neon.js",
    "generate-icons": "node scripts/generate-icons.js",
    "generate:og": "node scripts/generate-og-images.js",
    "check:readability": "node scripts/check-readability.js",
    "check:i18n": "node scripts/check-i18n.js",
    "snapshot:update": "node scripts/snapshot-pages.js --update",
    "snapshot:verify": "node scripts/snapshot-pages.js",
    "check:readability:strict": "node scripts/check-readability.js --strict",
    "check:links": "node scripts/check-links.js",
    "check:a11y": "node scripts/check-a11y.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/react": "^10.63.0",
    "fuse.js": "^7.1.0",
    "i18next": "^26.4.0",
    "lucide-react": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.12.1",
    "dotenv": "^17.2.3",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.6",
    "terser": "^5.44.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.0"
  }
}

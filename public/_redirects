# Netlify redirects file

# WWW to non-WWW redirect (301 permanent) - must come first
https://www.transplantmedicationnavigator.com/*  https://transplantmedicationnavigator.com/:splat  301!

# Admin auth API (must be before generic /api/*)
/api/admin-auth/*  /.netlify/functions/admin-auth/:splat  200!

# Admin seed (one-time setup — DELETE after use)
/api/admin-seed  /.netlify/functions/admin-seed  200!

# Admin API (must be before generic /api/*)
/api/admin-api/*  /.netlify/functions/admin-api/:splat  200!

# Chat API
/api/chat  /.netlify/functions/chat  200!

# Generic API route
/api/*  /.netlify/functions/:splat  200!

# Outbound tracking redirects
/out/copay/*  /.netlify/functions/out-redirect  200!
/out/foundation/*  /.netlify/functions/out-redirect  200!
/out/pap/*  /.netlify/functions/out-redirect  200!

# Spanish lives at the /es/ path prefix: scripts/prerender-seo.js writes
# every Spanish page to dist/es/<route>/index.html and Netlify serves the
# static files directly — no query parameter involved, so shorteners, QR
# generators, and preview bots that drop query strings can no longer strand
# a patient on the English page.
#
# Legacy ?lang=es URLs (indexed by Google, in old bookmarks and shared
# links) permanently redirect to their /es/ equivalent. Forced (!) because
# non-forced rules are skipped when the path resolves to an existing static
# file (verified on deploy preview #750). The query condition keeps
# parameterless requests untouched; ?lang=en needs no rule — the client
# still honors it, and the plain path already serves English.
#
# One rule per published legacy URL, never a catch-all: Netlify forwards
# the query string on redirects (observed live: /trumprx?lang=es 302'd to
# /trumprx-es?lang=es), so a generic /* rule would match its own /es/...
# target again and loop. These targets never re-match — no lang rule
# touches /es/... or /trumprx-es — and the forwarded ?lang=es left on the
# target URL is harmless (the app strips it client-side).
/trumprx  lang=es  /trumprx-es  301!
/  lang=es  /es/  301!
/wizard  lang=es  /es/wizard  301!
/education  lang=es  /es/education  301!
/application-help  lang=es  /es/application-help  301!
/faq  lang=es  /es/faq  301!
/medications  lang=es  /es/medications  301!
# Per-medication pages — after the exact /medications rule above.
/medications/*  lang=es  /es/medications/:splat  301!
/evidence  lang=es  /es/evidence  301!
/my-medications  lang=es  /es/my-medications  301!
/savings-tracker  lang=es  /es/savings-tracker  301!
/survey  lang=es  /es/survey  301!
/survey/transplant  lang=es  /es/survey/transplant  301!
/survey/general  lang=es  /es/survey/general  301!
/pilot  lang=es  /es/pilot  301!
/terms-and-conditions  lang=es  /es/terms-and-conditions  301!
/privacy  lang=es  /es/privacy  301!
/accessibility  lang=es  /es/accessibility  301!
/about  lang=es  /es/about  301!
/feedback  lang=es  /es/feedback  301!
/education/appeals  lang=es  /es/education/appeals  301!

